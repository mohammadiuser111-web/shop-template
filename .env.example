# ============================================
# Shop Template - Environment Variables Example
# ============================================
# Copy this file to .env and fill in the values
# ============================================

# ============================================
# Django Settings
# ============================================

# Debug mode (True for development, False for production)
DEBUG=True

# Django settings module
DJANGO_SETTINGS_MODULE=shop_template.settings.development

# Secret key (generate a new one for production)
# Use: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-in-production

# Allowed hosts (comma separated)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Internal IPs (for debug toolbar)
INTERNAL_IPS=127.0.0.1

# ============================================
# Database Settings
# ============================================

# SQLite (for development)
# DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL (recommended for production)
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres

# MySQL
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# ============================================
# Redis Settings
# ============================================

# Redis URL for caching
REDIS_URL=redis://redis:6379/0

# Celery broker URL
CELERY_BROKER_URL=redis://redis:6379/1

# Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ============================================
# Site Settings
# ============================================

# Site name
SITE_NAME=Shop Template

# Site description
SITE_DESCRIPTION=A complete e-commerce solution built with Django

# Site keywords
SITE_KEYWORDS=e-commerce, django, shop, store, online shopping

# Site author
SITE_AUTHOR=Shop Template Team

# Site email
SITE_EMAIL=info@shoptemplate.com

# Site phone
SITE_PHONE=+1 234 567 890

# Site address
SITE_ADDRESS=123 Main Street, City, Country

# Default currency
DEFAULT_CURRENCY=USD

# Default language
DEFAULT_LANGUAGE=en

# Timezone
TIMEZONE=UTC

# ============================================
# Email Settings
# ============================================

# SMTP Email (for development)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@shoptemplate.com

# Console Email (for development)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Mailgun (for production)
# EMAIL_BACKEND=anymail.backends.mailgun.EmailBackend
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_SENDER_DOMAIN=your-mailgun-domain

# SendGrid (for production)
# EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
# SENDGRID_API_KEY=your-sendgrid-api-key

# ============================================
# Payment Gateway Settings
# ============================================

# Stripe
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# ============================================
# Social Login Settings
# ============================================

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================
# Analytics Settings
# ============================================

# Google Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXX-X

# Google Tag Manager
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXX

# Facebook Pixel
FACEBOOK_PIXEL_ID=XXXXXXXXXXXXXX

# Hotjar
HOTJAR_ID=XXXXXX

# ============================================
# Security Settings
# ============================================

# Session settings
SESSION_COOKIE_AGE=1209600  # 2 weeks in seconds
SESSION_COOKIE_SECURE=False  # True for HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# CSRF settings
CSRF_COOKIE_SECURE=False  # True for HTTPS
CSRF_COOKIE_HTTPONLY=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# HTTPS settings (for production)
SECURE_SSL_REDIRECT=False  # True for production with HTTPS
SECURE_HSTS_SECONDS=0  # 31536000 for production (1 year)
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
REFERRER_POLICY=same-origin

# ============================================
# Storage Settings
# ============================================

# Local storage (default)
# MEDIA_ROOT=/app/media
# STATIC_ROOT=/app/staticfiles

# AWS S3 Storage (for production)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=your-region
# AWS_S3_CUSTOM_DOMAIN=your-custom-domain
# AWS_DEFAULT_ACL=None
# AWS_S3_OBJECT_PARAMETERS={'CacheControl': 'max-age=86400'}
# AWS_S3_FILE_OVERWRITE=False
# AWS_QUERYSTRING_AUTH=False

# Google Cloud Storage
# GS_BUCKET_NAME=your-bucket-name
# GS_PROJECT_ID=your-project-id
# GS_CREDENTIALS_JSON={"type": "service_account", ...}

# ============================================
# Cache Settings
# ============================================

# Cache backend (redis, memcached, locmem)
CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
CACHE_LOCATION=redis://redis:6379/0
CACHE_TIMEOUT=3600  # 1 hour in seconds

# ============================================
# Logging Settings
# ============================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG

# Log file path
LOG_FILE=/app/logs/django.log

# ============================================
# Pagination Settings
# ============================================

# Items per page
ITEMS_PER_PAGE=12

# Blog posts per page
BLOG_POSTS_PER_PAGE=10

# ============================================
# Feature Flags
# ============================================

# Enable/disable features
PRODUCT_REVIEWS_ENABLED=True
PRODUCT_REVIEWS_APPROVAL=True
PRODUCT_RATINGS_ENABLED=True
WISHLIST_ENABLED=True
COMPARE_ENABLED=True
NEWSLETTER_ENABLED=True
SOCIAL_LOGIN_ENABLED=True
TWO_FACTOR_AUTH_ENABLED=False
RECAPTCHA_ENABLED=False
ANALYTICS_ENABLED=False
MAINTENANCE_MODE=False

# ============================================
# Shipping Settings
# ============================================

# Flat rate shipping
SHIPPING_FLAT_RATE_COST=5.00
SHIPPING_FLAT_RATE_NAME=Flat Rate

# Free shipping
SHIPPING_FREE_THRESHOLD=50.00
SHIPPING_FREE_NAME=Free Shipping

# Local pickup
SHIPPING_LOCAL_PICKUP_COST=0.00
SHIPPING_LOCAL_PICKUP_NAME=Local Pickup

# ============================================
# Tax Settings
# ============================================

# Default tax rate (0.1 = 10%)
TAX_RATE=0.1

# ============================================
# Inventory Settings
# ============================================

# Low stock threshold
LOW_STOCK_THRESHOLD=10

# ============================================
# Order Settings
# ============================================

# Minimum order amount
MIN_ORDER_AMOUNT=10.00

# Maximum order amount
MAX_ORDER_AMOUNT=10000.00

# Order expiration time (in hours)
ORDER_EXPIRATION_TIME=24

# ============================================
# File Upload Settings
# ============================================

# Maximum file upload size (in MB)
FILE_UPLOAD_MAX_MEMORY_SIZE=10
FILE_UPLOAD_MAX_DISK_SIZE=100

# Allowed file extensions
FILE_UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.svg,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.mp4,.mov,.avi

# ============================================
# Rate Limiting Settings
# ============================================

# API rate limit
API_RATE_LIMIT=100/hour

# Login rate limit
LOGIN_RATE_LIMIT=5/minute

# ============================================
# Celery Settings
# ============================================

# Celery task timeout (in seconds)
CELERY_TASK_TIMEOUT=3600

# Celery task retry limit
CELERY_TASK_MAX_RETRIES=3

# Celery task retry delay (in seconds)
CELERY_TASK_DEFAULT_RETRY_DELAY=60

# ============================================
# Docker Settings
# ============================================

# Docker container name
DOCKER_CONTAINER_NAME=shop-template

# Docker network name
DOCKER_NETWORK_NAME=shop-template-network

# ============================================
# Notes
# ============================================
# 1. For production, set DEBUG=False
# 2. Generate a new SECRET_KEY for production
# 3. Use HTTPS in production (SECURE_SSL_REDIRECT=True)
# 4. Configure proper database for production
# 5. Configure proper email backend for production
# 6. Configure proper storage backend for production
# 7. Set up proper caching for production
# 8. Configure all required payment gateways
# 9. Set up proper analytics tracking
# 10. Configure proper logging for production
