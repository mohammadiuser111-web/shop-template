{
    "name": "Shop Template",
    "short_name": "ShopTemplate",
    "description": "A professional, resellable Django e-commerce template with store, blog, and admin panel sections.",
    "version": "1.0.0",
    "author": "Arena.ai",
    "homepage": "https://github.com/yourusername/shop-template",
    "repository": "https://github.com/yourusername/shop-template",
    "license": "MIT",
    "type": "template",
    "framework": "Django",
    "categories": [
        "e-commerce",
        "django",
