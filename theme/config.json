    "scripts": {
        "start": "python manage.py runserver",
        "start:dev": "python manage.py runserver 0.0.0.0:8000",
        "start:prod": "gunicorn --bind 0.0.0.0:8000 --workers 4 shop_template.wsgi:application",
        "start:async": "daphne -b 0.0.0.0 -p 8000 shop_template.asgi:application",
        "migrate": "python manage.py migrate",
        "makemigrations": "python manage.py makemigrations",
        "createsuperuser": "python manage.py createsuperuser",
        "collectstatic": "python manage.py collectstatic --noinput",
        "compress": "python manage.py compress",
        "test": "pytest",
        "test:cov": "pytest --cov=shop_template --cov-report=html",
        "lint": "flake8 . && isort --check-only . && black --check .",
        "format": "black . && isort .",
        "typecheck": "mypy .",
        "security": "bandit -r . && safety check",
        "celery": "celery -A shop_template worker -l info",
        "celery:beat": "celery -A shop_template beat -l info",
        "shell": "python manage.py shell_plus",
        "shell:ipython": "ipython manage.py shell_plus",
        "export": "python manage.py export",
        "import": "python manage.py import"
    },
    "docker": {
        "image": "shop-template",
        "container_name": "shop-template",
        "ports": ["8000:8000"],
        "volumes": [".:/app"],
        "environment": {
            "DEBUG": "True",
            "DJANGO_SETTINGS_MODULE": "shop_template.settings.development",
            "DATABASE_URL": "postgres://postgres:postgres@db:5432/postgres",
            "REDIS_URL": "redis://redis:6379/0",
            "CELERY_BROKER_URL": "redis://redis:6379/1",
            "CELERY_RESULT_BACKEND": "redis://redis:6379/2"
        },
        "depends_on": ["db", "redis"],
        "networks": ["shop-template-network"],
        "restart": "unless-stopped"
    },
    "docker_compose": {
        "version": "3.8",
        "services": {
            "web": {
                "build": ".",
                "command": "gunicorn --bind 0.0.0.0:8000 --workers 4 shop_template.wsgi:application",
                "volumes": [".:/app"],
                "ports": ["8000:8000"],
                "environment": {
                    "DEBUG": "False",
                    "DJANGO_SETTINGS_MODULE": "shop_template.settings.production",
                    "DATABASE_URL": "postgres://postgres:postgres@db:5432/postgres",
                    "REDIS_URL": "redis://redis:6379/0",
                    "SECRET_KEY": "your-secret-key-here",
                    "ALLOWED_HOSTS": ".localhost,127.0.0.1,0.0.0.0"
                },
                "depends_on": ["db", "redis"]
            },
            "db": {
                "image": "postgres:14",
                "environment": {
                    "POSTGRES_DB": "postgres",
                    "POSTGRES_USER": "postgres",
                    "POSTGRES_PASSWORD": "postgres"
                },
                "volumes": ["postgres_data:/var/lib/postgresql/data"],
                "ports": ["5432:5432"]
            },
            "redis": {
                "image": "redis:7",
                "ports": ["6379:6379"],
                "volumes": ["redis_data:/data"]
            },
            "celery": {
                "build": ".",
                "command": "celery -A shop_template worker -l info",
                "volumes": [".:/app"],
                "environment": {
                    "DEBUG": "False",
                    "DJANGO_SETTINGS_MODULE": "shop_template.settings.production",
                    "DATABASE_URL": "postgres://postgres:postgres@db:5432/postgres",
                    "REDIS_URL": "redis://redis:6379/0",
                    "CELERY_BROKER_URL": "redis://redis:6379/1",
                    "CELERY_RESULT_BACKEND": "redis://redis:6379/2"
                },
                "depends_on": ["db", "redis", "web"]
            },
            "celery-beat": {
                "build": ".",
                "command": "celery -A shop_template beat -l info",
                "volumes": [".:/app"],
                "environment": {
                    "DEBUG": "False",
                    "DJANGO_SETTINGS_MODULE": "shop_template.settings.production",
                    "DATABASE_URL": "postgres://postgres:postgres@db:5432/postgres",
                    "REDIS_URL": "redis://redis:6379/0"
                },
                "depends_on": ["db", "redis", "web"]
            }
        },
        "volumes": {
            "postgres_data": null,
            "redis_data": null
        },
        "networks": {
            "shop-template-network": {
                "driver": "bridge"
            }
        }
    },
    "environment": {
        "development": {
            "DEBUG": "True",
            "DJANGO_SETTINGS_MODULE": "shop_template.settings.development",
            "DATABASE_URL": "sqlite:///db.sqlite3",
            "SECRET_KEY": "dev-secret-key-change-in-production",
            "ALLOWED_HOSTS": "localhost,127.0.0.1",
            "INTERNAL_IPS": "127.0.0.1"
        },
        "staging": {
            "DEBUG": "False",
            "DJANGO_SETTINGS_MODULE": "shop_template.settings.staging",
            "DATABASE_URL": "postgres://postgres:postgres@db:5432/postgres",
            "REDIS_URL": "redis://redis:6379/0",
            "SECRET_KEY": "staging-secret-key",
            "ALLOWED_HOSTS": ".staging.example.com"
        },
        "production": {
            "DEBUG": "False",
            "DJANGO_SETTINGS_MODULE": "shop_template.settings.production",
            "DATABASE_URL": "postgres://user:password@localhost:5432/dbname",
            "REDIS_URL": "redis://localhost:6379/0",
            "SECRET_KEY": "production-secret-key",
            "ALLOWED_HOSTS": ".example.com",
            "SESSION_COOKIE_SECURE": "True",
            "CSRF_COOKIE_SECURE": "True",
            "SECURE_SSL_REDIRECT": "True"
        }
    },
