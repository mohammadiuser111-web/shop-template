"""
Local settings for Shop Template.

This file contains settings that should NOT be committed to version control.
Copy this file to local.py and customize it for your local development.

Example:
    cp shop_template/settings/local.py.example shop_template/settings/local.py
"""

# ============================================
# Database Settings
# ============================================

# Use SQLite for local development (default)
