    'default': {
        'ENGINE': 'django.db.backends.postgresql',
        'NAME': 'shop_template',
        'USER': 'postgres',
        'PASSWORD': 'postgres',
        'HOST': 'localhost',
        'PORT': '5432',
    }
}

