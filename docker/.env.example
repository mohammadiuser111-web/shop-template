# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False

# Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_NAME=shop_template
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis Settings
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,shop-template.com

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://localhost,https://shop-template.com

# Email Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@shop-template.com

# Payment Gateway Settings
# Zarinpal
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=True

# IDPay
IDPAY_API_KEY=your-idpay-api-key
IDPAY_SANDBOX=True

# Site Settings
SITE_NAME=Shop Template
SITE_DESCRIPTION=قالب حرفه‌ای فروشگاهی

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
